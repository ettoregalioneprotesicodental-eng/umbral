# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# Base de datos PostgreSQL (local en desarrollo)
DATABASE_URL=postgres://umbral:umbral_dev@localhost:5432/umbral

# Autenticación (Better Auth). Genera un secreto largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-aleatorio-largo
BETTER_AUTH_URL=http://localhost:3000

# IA: "demo" (sin coste, respuestas de plantilla identificadas) o "claude" (requiere clave).
AI_MODE=demo
# Solo en secretos del servidor. Déjalo vacío mientras no autorices consumo de API.
ANTHROPIC_API_KEY=
# Modelo de Claude. Por defecto claude-opus-5-5 (4 $/20 $ por millón de tokens de entrada/salida).
# Opción mucho más barata para el chat del entrenador: claude-haiku-5-5 (0,10 $/0,50 $).
# Verifica precios en https://www.anthropic.com/pricing antes de activar.
CLAUDE_MODEL=
# Tope de gasto en USD. Se reserva el peor caso ANTES de cada llamada; si no cabe, no se llama.
AI_DAILY_BUDGET_USD=0.50
AI_MONTHLY_BUDGET_USD=5

# Limitación de intentos de acceso. Solo desactivar en pruebas automáticas.
AUTH_RATE_LIMIT=on
# Correo: "dev-outbox" guarda los mensajes en .dev-mail/ sin enviarlos.
MAIL_MODE=dev-outbox
